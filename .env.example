# Copy this file as .env (next to docker-compose.yml) and change the values.
# .env is never committed: real passwords live there.

# Database (only reachable inside Docker)
POSTGRES_DB=infection_skillhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password

# API
# Key used to sign the JWT: 32 characters or more, different for each environment.
# A good one: openssl rand -base64 48
JWT_SIGNING_KEY=change-this-key-for-a-long-random-one-0123456789
OPENAPI_ENABLED=true

# Published ports. On the esthercita server the project uses 8666 and 8667.
# Once a domain points to them through the server's Nginx, they can be closed to the outside
# with 127.0.0.1:8666 and 127.0.0.1:8667.
API_PORT=8666
CLIENT_PORT=8667

# Folder of the client repository (by default cloned next to this one)
CLIENT_BUILD_CONTEXT=../InfectionSkillHub.Client

# Origin allowed by CORS for the Angular dev server (npm start)
CLIENT_DEV_ORIGIN=http://localhost:4200
